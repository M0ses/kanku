[Unit]
Description=Store and restore kanku iptables rules
After=local-fs.target network.target
ConditionPathNotExists=/run/lock/kanku-network-setup.lock

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/kanku/network-setup.pl - configure_iptables
ExecStop=/usr/lib/kanku/network-setup.pl - cleanup_iptables

[Install]
WantedBy=multi-user.target
